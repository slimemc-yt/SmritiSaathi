rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isPatientDevice(patientId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/patients/$(patientId)/deviceLinks/$(request.auth.uid));
    }

    function isLinkedFamily(patientId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/patients/$(patientId)/familyLinks/$(request.auth.uid));
    }

    function isAssignedDoctor(patientId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/patients/$(patientId)/assignedDoctors/$(request.auth.uid));
    }

    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // ============================================
    // DOCTORS & HOSPITALS DIRECTORY (READ-ONLY)
    // ============================================
    match /doctors/{doctorId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == doctorId;
    }

    match /hospitals/{hospitalId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ============================================
    // CANONICAL PATIENTS COLLECTION
    // ============================================
    match /patients/{patientId} {
      // Patient document - readable by linked family, assigned doctors, and paired patient device
      allow read: if isLinkedFamily(patientId) || isAssignedDoctor(patientId) || isPatientDevice(patientId) || resource.data.createdBy == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isLinkedFamily(patientId) || isPatientDevice(patientId) || resource.data.createdBy == request.auth.uid;
      allow delete: if isLinkedFamily(patientId) || resource.data.createdBy == request.auth.uid;

      // Family links subcollection
      match /familyLinks/{familyUid} {
        allow read: if isLinkedFamily(patientId) || isAssignedDoctor(patientId) || request.auth.uid == familyUid;
        allow write: if isLinkedFamily(patientId) || request.auth.uid == familyUid;
      }

      // Patient device links subcollection (Anonymous Auth pairing)
      match /deviceLinks/{deviceUid} {
        allow read: if isLinkedFamily(patientId) || request.auth.uid == deviceUid;
        allow write: if isAuthenticated();
      }

      // Assigned doctors subcollection
      match /assignedDoctors/{doctorUid} {
        allow read: if isLinkedFamily(patientId) || isAssignedDoctor(patientId);
        allow write: if isLinkedFamily(patientId) || request.auth.uid == doctorUid;
      }

      // Game results subcollection
      match /gameResults/{sessionId} {
        allow read: if isLinkedFamily(patientId) || isAssignedDoctor(patientId) || isPatientDevice(patientId);
        allow write: if isPatientDevice(patientId) || isLinkedFamily(patientId);
      }

      // Reminders subcollection
      match /reminders/{reminderId} {
        allow read: if isLinkedFamily(patientId) || isPatientDevice(patientId);
        allow write: if isLinkedFamily(patientId) || isPatientDevice(patientId);
      }

      // Behavioral alerts subcollection
      match /behavioralAlerts/{alertId} {
        allow read: if isLinkedFamily(patientId) || isAssignedDoctor(patientId) || isPatientDevice(patientId);
        allow write: if isPatientDevice(patientId) || isLinkedFamily(patientId);
      }

      // Real-time pending actions subcollection (Nudges, Game invites)
      match /pendingActions/{actionId} {
        allow read: if isPatientDevice(patientId) || isLinkedFamily(patientId);
        allow write: if isLinkedFamily(patientId) || isPatientDevice(patientId);
      }

      // Reminiscence content subcollection
      match /reminiscenceContent/{contentId} {
        allow read: if isLinkedFamily(patientId) || isPatientDevice(patientId);
        allow write: if isLinkedFamily(patientId);
      }

      // Clinical notes subcollection
      match /clinicalNotes/{noteId} {
        allow read: if isLinkedFamily(patientId) || isAssignedDoctor(patientId);
        allow write: if isAssignedDoctor(patientId) || request.auth.uid == resource.data.doctorUid;
      }
    }
  }
}
